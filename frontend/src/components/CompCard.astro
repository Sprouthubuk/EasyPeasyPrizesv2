---
// Easy Peasy's competition card: square picture with solid pills, title, "Win up to" line,
// the price per entry, % sold with the time left, the draw date and one Enter Now button.
import type { CompetitionSummary } from "../lib/types";
import { formatMoney, formatPence } from "../lib/money";
import { endsIn, ukWhen } from "../lib/time";
interface Props { c: CompetitionSummary }
const { c } = Astro.props;
const live = c.type === "draw";
const href = `/competitions/${c.slug}`;
const soon = c.status === "scheduled" && c.opensAt ? c.opensAt : null;
const open = c.status === "live";
const soldOut = c.status === "sold_out";
const sold = Math.max(0, Math.min(100, c.soldPercent));
const msLeft = new Date(c.closesAt).getTime() - Date.now();
const endingSoon = open && msLeft > 0 && msLeft < 864e5;
const money = (p: number) => formatPence(p, { short: false });
// The pink line under the title: the headline prize, never a repeat of the title.
const headline = c.endPrize ? `${c.endPrize.count > 1 ? `${c.endPrize.count} × ` : ""}${money(c.endPrize.valuePence)} end prize`
  : c.topPrizePence ? (live ? `Worth ${money(c.topPrizePence)}` : `Win up to ${money(c.topPrizePence)}`) : null;
// The flag across the foot of the picture: a cash prize, or the first words of the title.
const cash = c.title.match(/^£[\d,.]+/);
const flag = soldOut ? "Sold Out" : !open && !soon ? "Closed" : soon ? `Opens ${ukWhen(soon)}` : cash ? `${cash[0]} Cash` : c.title.split(" ").slice(0, 3).join(" ");
const drawWhen = c.drawAt ?? c.closesAt;
---
<a class={`cc gg-card ${soldOut || (!open && !soon) ? "cc-done" : ""}`} href={href}>
  <div class="im">
    <img src={c.imageSmall} srcset={c.imageSrcset ?? undefined} sizes="(min-width:1280px) 330px, (min-width:1024px) 30vw, 50vw" alt={c.title} loading="lazy" decoding="async" width="400" height="400">
    <div class="pills">
      <span class={`pill ${live ? "pill-live" : "pill-iw"}`}>{live ? "Live Draw" : "Instant Win"}</span>
      {!live && c.boost && <span class="pill pill-boost" data-testid="boost-badge">Prize Boost</span>}
    </div>
    {endingSoon && <span class="pill pill-iw pill-tr">Ending Soon</span>}
    <span class={`pill pill-flag ${soldOut || (!open && !soon) ? "pill-out" : "pill-iw"}`}>{flag}</span>
  </div>
  <div class="bd">
    <div class="tt">{c.title}</div>
    {headline && <div class="hl">{headline}</div>}
    {!live && c.boost && <div class="pbl">{money(c.boost.addedPence)} extra instant wins added</div>}
    <div class="pr"><b class="pp">{formatMoney(c.pricePence)}</b><span>per entry</span></div>
    <div class="sl"><span><b>{sold}%</b> sold</span>{open ? <span data-ends={c.closesAt}>{endsIn(c.closesAt)}</span> : soon ? <span>Opens soon</span> : <span>Closed</span>}</div>
    <div class="bar"><div style={`width:${sold > 0 ? Math.max(sold, 2) : 0}%`}></div></div>
    {open && sold >= 90 ? <div class="ag">Almost gone!</div> : c.featuredBundle && open ? <div class="bb">{c.featuredBundle.label}</div> : null}
    <div class="wh">Draw {ukWhen(drawWhen)}</div>
    <span class={`btn btn-block go ${open || soon ? "btn-y" : "btn-o"}`}>{!open && !soon ? "View Result" : soon ? "See The Prizes" : "Enter Now"}</span>
  </div>
</a>
