---
import { createHash } from "node:crypto";
/** Asks once about marketing cookies (the Meta Pixel). Shown only when a Pixel ID is set in the admin. */
const pixelId = Astro.locals.site.metaPixelId ?? "";
// Signed-in players: hashed here (SHA-256, as Meta asks), so the plain email never sits in the page for the Pixel.
const me = Astro.locals.me;
const sha = (v: string) => createHash("sha256").update(v).digest("hex");
const em = me ? sha(me.email.trim().toLowerCase()) : undefined;
const xid = me ? sha(String(me.id)) : undefined;
---
{pixelId && (
  <div class="ck" id="cookie-banner" data-pixel={pixelId} data-em={em} data-xid={xid} role="dialog" aria-live="polite" aria-label="Cookie choice" hidden>
    <p class="ck-t"><b>Cookies</b> We use Meta's marketing cookies, and tell Meta when you sign up or buy, to see which of our adverts work. They stay off unless you accept. <a href="/legal/cookies">Cookie policy</a></p>
    <div class="ck-b">
      <button type="button" class="ck-btn" data-choice="rejected">Reject</button>
      <button type="button" class="ck-btn is-on" data-choice="accepted">Accept</button>
    </div>
  </div>
)}
<script>
  import { readConsent, saveConsent, startPixel, syncConsentCookie } from "../lib/consent";
  syncConsentCookie();
  const banner = document.getElementById("cookie-banner");
  const id = banner?.dataset.pixel ?? "";
  if (banner && id) {
    if (readConsent() === null) banner.hidden = false;
    else startPixel(id);
    banner.querySelectorAll<HTMLButtonElement>("[data-choice]").forEach((b) =>
      b.addEventListener("click", () => {
        const choice = b.dataset.choice as "accepted" | "rejected";
        const had = readConsent();
        saveConsent(choice);
        banner.hidden = true;
        // Withdrawing stops the Pixel straight away: reload without it.
        if (had === "accepted" && choice === "rejected") location.reload();
        else startPixel(id);
      }),
    );
    document.querySelectorAll("[data-cookie-settings]").forEach((el) =>
      el.addEventListener("click", (e) => {
        e.preventDefault();
        banner.hidden = false;
        banner.querySelector<HTMLButtonElement>("[data-choice='rejected']")?.focus();
      }),
    );
  } else {
    // No Pixel set: there is nothing to choose, so the footer link just goes to the policy.
    document.querySelectorAll<HTMLElement>("[data-cookie-settings]").forEach((el) => (el.hidden = true));
  }
</script>
<style>
  .ck { font-family: Manrope, system-ui, sans-serif; position: fixed; left: 12px; right: 12px; bottom: 96px; z-index: 60; max-width: 520px; margin: 0 auto; padding: 14px; border-radius: 18px; background: #0E1123; border: 1px solid rgba(255,30,140, 0.55); box-shadow: 0 0 40px rgba(255,30,140, 0.18), 0 18px 40px rgba(0, 0, 0, 0.55); color: #fff; }
  .ck[hidden] { display: none; }
  .ck-t { margin: 0 0 12px; font-size: 14px; line-height: 1.5; font-weight: 600; color: #D3D7EA; }
  .ck-t b { color: #fff; margin-right: 4px; font-family: Sora, sans-serif; font-weight: 400; font-size: 16px; }
  .ck-t a { color: #FF6FD0; }
  .ck-b { display: flex; gap: 10px; }
  .ck-btn { flex: 1; min-height: 44px; border-radius: 999px; border: 1px solid rgba(255, 255, 255, 0.3); background: #080A16; color: #fff; font: 800 15px Manrope, system-ui, sans-serif; cursor: pointer; }
  .ck-btn.is-on { background: #00D2F5; border-color: #00D2F5; color: #05060E; }
  @media (min-width: 900px) { .ck { bottom: 20px; } }
</style>
