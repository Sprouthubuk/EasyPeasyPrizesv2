---
import Icon from "./Icon.astro";
const site = Astro.locals.site;
---
<footer class="ft"><div class="wrap stack g24">
  <div class="stack g16" style="align-items:center">
    <img src="/logo-sm.webp" alt="Easy Peasy Prizes" style="height:64px;width:auto;display:block" width="96" height="64" loading="lazy">
    <div class="row g8">
      {site.socials.instagram && <a class="ib" href={site.socials.instagram} aria-label="Instagram" rel="noopener" target="_blank" style="border-color:#FF1E8C;color:#FF6FD0"><Icon name="ig" size={18} /></a>}
      {site.socials.facebook && <a class="ib" href={site.socials.facebook} aria-label="Facebook group" rel="noopener" target="_blank" style="border-color:#3FD8FF;color:#3FD8FF"><Icon name="fb" size={18} /></a>}
      {site.socials.youtube && <a class="ib" href={site.socials.youtube} aria-label="YouTube" rel="noopener" target="_blank" style="border-color:#FF1E8C;color:#FF6FD0"><Icon name="yt" size={18} /></a>}
      {site.socials.tiktok && <a class="ib" href={site.socials.tiktok} aria-label="TikTok" rel="noopener" target="_blank" style="border-color:#3FD8FF;color:#3FD8FF"><Icon name="tt" size={18} /></a>}
    </div>
  </div>
  <div class="ft-cols">
    <div class="stack g8"><h2 style="color:#FF6FD0">Play</h2><a href="/competitions">All Competitions</a><a href="/competitions?type=instant">Instant Wins</a><a href="/competitions?type=draw">Live Draws</a><a href="/winners">Winners</a></div>
    <div class="stack g8"><h2 style="color:#3FD8FF">Help</h2><a href="/how-it-works">How It Works</a><a href="/faq">FAQs</a><a href="/contact">Contact Us</a><a href="/account">My Account</a></div>
    <div class="stack g8"><h2 style="color:#00D2F5">The Rules</h2><a href="/legal/terms">Terms &amp; Conditions</a><a href="/free-entry">Free Postal Entry</a><a href="/legal/privacy">Privacy Policy</a><a href="/legal/cookies">Cookie Policy</a><a href="/legal/cookies" data-cookie-settings>Cookie Settings</a></div>
    <div class="stack g8"><h2 style="color:#D3D7EA">Safer Play</h2><a href="/account/safer-play">Set Limits</a><a href="/account/safer-play">Take A Break</a><a href="/legal/complaints">Complaints</a></div>
  </div>
  <div class="row wrapx g8" style="justify-content:center"><span class="tag tag-y">18+ UK only</span><span class="tag tag-c">Free postal entry</span></div>
  <ul class="pay-marks" aria-label="We accept">
    <li><img src="/payments/visa.svg" alt="Visa" width="44" height="14" /></li>
    <li><img src="/payments/mastercard.svg" alt="Mastercard" width="30" height="23" /></li>
    <li><img src="/payments/apple-pay.svg" alt="Apple Pay" width="46" height="19" /></li>
    <li><img src="/payments/google-pay.svg" alt="Google Pay" width="48" height="19" /></li>
  </ul>
  <p style="margin:0 auto;line-height:1.6;max-width:820px">Easy Peasy Prizes is a prize competition operator in the United Kingdom. You must be 18 or over and a UK resident to enter. A free postal entry route is available on every competition. © {new Date().getFullYear()} Easy Peasy Prizes Ltd · Registered in Scotland · Company No. SC747746 · Clyde Offices 2nd Floor, 48 West George Street, Glasgow, G2 1BP.</p>
</div></footer>
