---
import Icon from "./Icon.astro";
const site = Astro.locals.site;
// Easy Peasy's footer: brand and company line on the left, three link columns, then a payments bar.
const columns: [string, [string, string, boolean?][]][] = [
  ["Competitions", [["All Competitions", "/competitions"], ["Instant Wins", "/competitions?type=instant"], ["Live Draws", "/competitions?type=draw"], ["Results", "/winners"], ["Instant Winners", "/instant-winners"], ["Entry Lists", "/entry-lists"]]],
  ["Support", [["Contact Us", "/contact"], ["FAQs", "/faq"], ["How To Enter", "/how-it-works"], ["Free Postal Entry", "/free-entry"], ["About Us", "/about"], ["My Account", "/account"]]],
  ["Legal", [["Terms & Conditions", "/legal/terms"], ["Privacy Policy", "/legal/privacy"], ["Cookie Policy", "/legal/cookies"], ["Cookie Settings", "/legal/cookies", true], ["Complaints", "/legal/complaints"], ["Responsible Play", "/account/safer-play"]]],
];
const socials: [string | null, string, string][] = [
  [site.socials.facebook, "Facebook group", "fb"],
  [site.socials.instagram, "Instagram", "ig"],
  [site.socials.youtube, "YouTube", "yt"],
  [site.socials.tiktok, "TikTok", "tt"],
];
---
<footer class="ft">
  <div class="wrap ft-main">
    <div class="ft-brand">
      <a href="/" class="ft-logo" aria-label="Easy Peasy Prizes home"><img src="/logo-sm.webp" alt="Easy Peasy Prizes" width="144" height="96" loading="lazy"></a>
      <p>Easy Peasy Prizes Ltd · Registered in Scotland · Company No. SC747746 · Clyde Offices 2nd Floor, 48 West George Street, Glasgow, G2 1BP</p>
      <div class="ft-soc">{socials.filter(([href]) => href).map(([href, label, icon]) => <a href={href!} aria-label={`Easy Peasy Prizes on ${label}`} rel="noopener" target="_blank"><Icon name={icon} size={18} /></a>)}</div>
    </div>
    <div class="ft-cols">
      {columns.map(([heading, links]) => (
        <div><h2>{heading}</h2><ul>{links.map(([label, href, cookie]) => <li><a href={href} data-cookie-settings={cookie ? "" : undefined}>{label}</a></li>)}</ul></div>
      ))}
    </div>
  </div>
  <div class="ft-bar"><div class="wrap ft-bar-in">
    <div class="ft-pay">
      <ul class="pay-marks" aria-label="We accept">
        <li><img src="/payments/visa.svg" alt="Visa" width="44" height="14" /></li>
        <li><img src="/payments/mastercard.svg" alt="Mastercard" width="30" height="23" /></li>
        <li><img src="/payments/google-pay.svg" alt="Google Pay" width="48" height="19" /></li>
        <li><img src="/payments/apple-pay.svg" alt="Apple Pay" width="46" height="19" /></li>
      </ul>
      <p>© {new Date().getFullYear()} Easy Peasy Prizes Ltd. All rights reserved.</p>
    </div>
    <p class="ft-rg">18+ only · Please play responsibly · <a href="https://www.begambleaware.org" rel="noopener" target="_blank">BeGambleAware</a> · <a href="/free-entry">Free postal entry</a></p>
  </div></div>
</footer>
