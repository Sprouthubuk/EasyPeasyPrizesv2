---
import Icon from "./Icon.astro";
import { formatMoney } from "../lib/money";
interface Props { active?: string; variant?: "main" | "auth" | "secure" | "menu"; back?: string; title?: string }
const { active = "", variant = "main", back = "/", title = "Secure checkout" } = Astro.props;
const me = Astro.locals.me;
const trust = Astro.locals.site?.trust;
// Easy Peasy's own nav: the same six links as the old site.
const nav = [
  ["Competitions", "/competitions", "competitions"],
  ["Instant Wins", "/competitions?type=instant", "instant-wins"],
  ["Instant Winners", "/instant-winners", "instant-winners"],
  ["Results", "/winners", "winners"],
  ["Entry Lists", "/entry-lists", "entry-lists"],
  ["About", "/about", "about"],
];
const pounds = (n: number, compact: boolean) => compact && n >= 1_000_000 ? `£${(n / 1_000_000).toFixed(2).replace(/\.00$/, "")}m` : compact && n >= 1000 ? `£${(n / 1000).toFixed(1).replace(/\.0$/, "")}k` : `£${n.toLocaleString("en-GB")}`;
const paidOut = trust?.paidOutPounds ?? null;
---
{variant === "main" && (
  <div class="ep-top">
    <div class="ep-util"><div class="wrap ep-util-in">
      <span class="ep-util-l">{paidOut !== null && paidOut > 0 && <b><span class="mob">{pounds(paidOut, true)} paid out</span><span class="dskf">{pounds(paidOut, false)} paid out to our winners</span></b>}</span>
      {trust?.supportingName && <span class="ep-util-r">Proudly supporting {trust.supportingUrl ? <a href={trust.supportingUrl} rel="noopener" target="_blank">{trust.supportingName}</a> : <span class="cy">{trust.supportingName}</span>}</span>}
    </div></div>
    <header class="hd"><div class="wrap hd-in">
      <a class="ib burger" href="/menu" aria-label="Open menu"><Icon name="menu" /></a>
      <a class="logo" href="/" aria-label="Easy Peasy Prizes home"><img src="/logo-sm.webp" alt="Easy Peasy Prizes" width="96" height="64"></a>
      <nav class="nav" aria-label="Main">{nav.map(([n, href, key]) => <a href={href} class={key === active ? "on" : ""} aria-current={key === active ? "page" : undefined}>{n}</a>)}</nav>
      <div class="hd-r">
        <a class="ib cart" href="/basket" aria-label="Basket"><Icon name="cart" size={18} /><span class="badge" data-basket-count hidden></span></a>
        {me ? (
          <>
            <a class="hd-wal" href="/account/wallet" aria-label={`Wallet balance ${formatMoney(me.wallet.totalPence)}`}><Icon name="wallet" size={16} /><span data-wallet>{formatMoney(me.wallet.totalPence)}</span></a>
            <a class="btn btn-y btn-sm hd-cta" href="/account">My Account</a>
          </>
        ) : (
          <>
            <a class="hd-link" href="/login">Log In</a>
            <a class="btn btn-y btn-sm hd-cta" href="/join">Sign Up</a>
          </>
        )}
      </div>
    </div></header>
  </div>
)}
{variant === "auth" && (
  <header class="auth-hd"><div class="wrap row g12" style="height:64px">
    <a href={back} class="hd-back"><Icon name="back" size={16} />Back</a>
    <a href="/" class="logo" aria-label="Home" style="margin-left:auto"><img src="/logo-sm.webp" alt="Easy Peasy Prizes" style="height:44px" width="66" height="44"></a>
  </div></header>
)}
{variant === "secure" && (
  <header class="auth-hd"><div class="wrap row g12" style="height:64px">
    <a href={back} class="ib" aria-label="Back"><Icon name="back" size={18} /></a>
    <div class="row g8" style="flex:1;justify-content:center;font-weight:700"><Icon name="lock" size={16} />{title}</div>
    <a href="/" class="logo" aria-label="Home"><img src="/logo-sm.webp" alt="Easy Peasy Prizes" style="height:44px" width="66" height="44"></a>
  </div></header>
)}
{variant === "menu" && (
  <header class="auth-hd"><div class="wrap row g12" style="height:64px">
    <a href="/" class="logo" aria-label="Home"><img src="/logo-sm.webp" alt="Easy Peasy Prizes" style="height:44px" width="66" height="44"></a>
    <a href={back} class="ib" aria-label="Close menu" style="margin-left:auto"><Icon name="close" size={18} /></a>
  </div></header>
)}
