---
import { gameName } from "../../lib/gameLabels";
import Layout from "../../layouts/Layout.astro";
import CompCard from "../../components/CompCard.astro";
import Icon from "../../components/Icon.astro";
import type { CompetitionSummary } from "../../lib/types";

const { api } = Astro.locals;
const q = (Astro.url.searchParams.get("q") ?? "").trim().slice(0, 60);
const type = Astro.url.searchParams.get("type") ?? "all";
const sort = Astro.url.searchParams.get("sort") ?? "ending";
const { data: all } = await api.get<{ data: CompetitionSummary[] }>("/api/competitions?status=live");

const TYPES: [string, string, (c: CompetitionSummary) => boolean][] = [
  ["all", "All", () => true],
  ["instant", "Instant Wins", (c) => c.type === "instant"],
  ["draw", "Live Draws", (c) => c.type === "draw"],
  ["under10", "Under 10p", (c) => c.pricePence < 10],
  ["christmas", "Christmas", (c) => c.skin === "christmas"],
];
const t = TYPES.find((x) => x[0] === type) ?? TYPES[0];
// Each category is its own search result (canonical keeps ?type); a search or a re-sort is not.
const SEO: Record<string, { title: string; h1: [string, string]; description: string }> = {
  all: { title: "Live UK Competitions & Raffles | Easy Peasy Prizes", h1: ["All", "Competitions"], description: "Every live Easy Peasy competition: instant win games and live draw raffles for cash, tech and more, from 1p a ticket. 18+ UK, free postal entry." },
  instant: { title: "Instant Win Competitions UK | Easy Peasy Prizes", h1: ["Instant Win", "Competitions"], description: "Instant win competitions: buy a ticket, play the reveal game and see straight away if you've won cash or a prize. 18+ UK, free postal entry." },
  draw: { title: "Live Draw Competitions & Raffles | Easy Peasy Prizes", h1: ["Live Draw", "Competitions"], description: "Prize draws and raffles drawn live when they close. Pick your tickets, watch the draw and see every winner published. 18+ UK, free postal entry." },
  under10: { title: "Competitions Under 10p | Easy Peasy Prizes", h1: ["Under 10p", "Competitions"], description: "Cheap UK competitions with tickets under 10p: instant win games and live draws for cash and prizes. 18+ UK only, free postal entry." },
  christmas: { title: "Christmas Competitions | Easy Peasy Prizes", h1: ["Christmas", "Competitions"], description: "Christmas prize competitions: festive instant win games and live draws for cash and prizes. 18+ UK only, free postal entry on every one." },
};
const seo = SEO[t[0]] ?? SEO.all;
const INTRO: Record<string, string> = {
  all: "Every live competition in one place: instant wins you can play straight away and live draws for bigger prizes.",
  instant: "Reveal your ticket the moment you check out, and any prize you win is credited straight to your account.",
  draw: "Pick your tickets and watch the draw. Every winner and winning ticket number is published when the competition closes.",
  under10: "Low-cost entries: instant wins and live draws with tickets under 10p.",
  christmas: "Festive instant wins and live draws.",
};
let list = all.filter(t[2]);
if (q) list = list.filter((c) => `${c.title} ${c.gameLabel ?? ""} ${gameName(c) ?? ""}`.toLowerCase().includes(q.toLowerCase()));
const sorters: Record<string, (a: CompetitionSummary, b: CompetitionSummary) => number> = {
  ending: (a, b) => a.closesAt.localeCompare(b.closesAt),
  price: (a, b) => a.pricePence - b.pricePence,
  prize: (a, b) => (b.topPrizePence ?? 0) - (a.topPrizePence ?? 0),
  newest: (a, b) => b.closesAt.localeCompare(a.closesAt),
};
list = [...list].sort(sorters[sort] ?? sorters.ending);
const link = (k: string) => {
  const u = new URLSearchParams();
  if (k !== "all") u.set("type", k);
  if (q) u.set("q", q);
  if (sort !== "ending") u.set("sort", sort);
  const s = u.toString();
  return `/competitions${s ? "?" + s : ""}`;
};
---
<Layout title="All Competitions" fullTitle={seo.title} active={t[0] === "instant" ? "instant-wins" : "competitions"} description={seo.description} canonicalKeys={["type"]} noindex={!!q}>
  <section class="ep-pagehead"><div class="wrap">
    <nav class="ep-crumbs" aria-label="Breadcrumb"><a href="/competitions">Competitions</a>{t[0] !== "all" && <> / <b>{t[1]}</b></>}</nav>
    <div class="ep-listhead">
      <div><h1 class="h1">{t[0] === "all" ? "All Competitions" : t[0] === "instant" ? "Instant Wins" : t[0] === "draw" ? "Live Draws" : seo.h1.join(" ")}</h1><p class="p">{INTRO[t[0]] ?? INTRO.all}</p></div>
      <form class="ep-listtools" method="get" action="/competitions" role="search">
        {type !== "all" && <input type="hidden" name="type" value={type}>}
        <label class="ep-search"><Icon name="search" size={16} /><input class="inp" type="search" name="q" value={q} placeholder="Search competitions" aria-label="Search competitions"></label>
        <span class="hint dskf" style="white-space:nowrap">Showing <b style="color:#EEF0FF">{list.length}</b>{" "}{list.length === 1 ? "competition" : "competitions"}</span>
        <label class="ep-sort"><span>Sort</span><select name="sort" aria-label="Sort" onchange="this.form.submit()">
          <option value="ending" selected={sort === "ending"}>Ending soonest</option>
          <option value="price" selected={sort === "price"}>Price: low to high</option>
          <option value="prize" selected={sort === "prize"}>Biggest prize</option>
          <option value="newest" selected={sort === "newest"}>Newest</option>
        </select><Icon name="down" size={14} /></label>
        <noscript><button class="btn btn-o btn-sm" type="submit">Go</button></noscript>
      </form>
    </div>
  </div></section>
  <section class="ep-filterbar"><div class="wrap"><div class="scrollx" role="group" aria-label="Filter"><span class="hint dskf" style="align-self:center;margin-right:4px">Filter by</span>{TYPES.filter(([k, , f]) => k === "all" || k === t[0] || all.some(f)).map(([k, label, f]) => <a class={`chip ${k === t[0] ? "on" : ""}`} href={link(k)} aria-current={k === t[0] ? "true" : undefined}>{label} <span class="ep-count">{all.filter(f).length}</span></a>)}</div></div></section>
  <section class="sec" style="padding-top:40px"><div class="wrap">
    {list.length ? <div class="grid-c">{list.map((c) => <CompCard c={c} />)}</div> : <div class="card empty">No competitions match that. <a class="tap" href="/competitions">Show all</a></div>}
  </div></section>
  <section class="ep-ctaband"><div class="wrap ep-ctaband-in">
    <div><h2 class="h2">{t[0] === "draw" ? "How live draws work" : t[0] === "instant" ? "How instant wins work" : "How it works"}</h2><p class="p">{t[0] === "draw" ? "Every ticket number is given at random. When the competition closes, the winning ticket is drawn and published on our results page." : "Choose your entries and complete checkout. Instant win tickets are revealed straight away, with any prize credited directly to your account."}</p></div>
    <div class="row wrapx g12"><a class="btn btn-y" href="/how-it-works">How It Works</a><a class="btn btn-o" href="/free-entry">Free Postal Entry</a>{t[0] !== "all" && <a class="btn btn-o" href="/competitions">View All Competitions</a>}</div>
  </div></section>
</Layout>
