---
import PageHead from "../components/PageHead.astro";
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import ContactForm from "../islands/ContactForm";
const { me, site } = Astro.locals;
---
<Layout title="Contact Us" description="Get in touch with the Easy Peasy Prizes team about a competition, your tickets, a payment or a prize. We are here to help.">
  <PageHead title="Get In Touch" lead="Have a question about a competition, need help with an entry, or just want to say hello? We’d love to hear from you." center />
  <section class="sec"><div class="wrap split">
    <div class="stack g16">
      <a class="card card-p row g12 gg-card" href="/faq" style="text-decoration:none;color:#fff"><span style="width:44px;height:44px;border-radius:14px;border:1px solid #3FD8FF;color:#3FD8FF;display:flex;align-items:center;justify-content:center"><Icon name="help" size={22} /></span><span style="flex:1"><b>Quick Answers</b><span class="hint" style="display:block">Most questions are covered in the FAQs</span></span><Icon name="chev" /></a>
      {site.socials.facebook && <a class="card card-p row g12 gg-card" href={site.socials.facebook} rel="noopener" target="_blank" style="text-decoration:none;color:#fff"><span style="width:44px;height:44px;border-radius:14px;border:1px solid #FF1E8C;color:#FF6FD0;display:flex;align-items:center;justify-content:center"><Icon name="fb" size={22} /></span><span style="flex:1"><b>Facebook Community</b><span class="hint" style="display:block">Join the group, post your wins</span></span><Icon name="chev" /></a>}
      <div class="card card-p stack g8">{site.supportEmail && <><span class="eyebrow">Email</span><a href={`mailto:${site.supportEmail}`} style="font-weight:900">{site.supportEmail}</a></>}<span class="eyebrow" style="margin-top:8px">Post</span><span class="muted" style="font-weight:700">Easy Peasy Prizes Ltd, Clyde Offices 2nd Floor, 48 West George Street, Glasgow, G2 1BP</span></div>
    </div>
    <ContactForm client:load name={me ? `${me.firstName} ${me.lastName}` : ""} email={me?.email ?? ""} />
  </div></section>
</Layout>
