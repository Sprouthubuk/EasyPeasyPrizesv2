---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import type { ArchiveWinnerRow, DrawWinnerRow, CompetitionSummary } from "../lib/types";
import { ago, ukDate, ukDateTime } from "../lib/time";
const { api } = Astro.locals;
const { data: winners } = await api.get<{ data: DrawWinnerRow[] }>("/api/winners/draws");
const { data: comps } = await api.get<{ data: CompetitionSummary[] }>("/api/competitions?status=live");
const upcoming = comps.filter((c) => c.type === "draw");
const { data: oldWinners } = await api.get<{ data: ArchiveWinnerRow[] }>("/api/archive/winners").catch(() => ({ data: [] as ArchiveWinnerRow[] }));
---
<Layout title="Competition Winners & Draw Results" active="winners" description="Every Easy Peasy Prizes draw winner, the ticket number that won and the live draw to watch back.">
  <section class="ep-reshero"><div class="wrap">
    <span class="ep-badge"><Icon name="shield" size={14} />Verified draws</span>
    <h1 class="h1 ep-big">Draw Results</h1>
    <p class="p ep-lead">Every draw, every winner. The full history of Easy Peasy Prizes results: transparent, time-stamped and checkable.</p>
    <div class="ep-resstats">
      <div><span class="label-caps"><Icon name="trophy" size={14} />Total draws</span><b class="d">{winners.length.toLocaleString("en-GB")}</b></div>
      <div><span class="label-caps"><Icon name="user" size={14} />Winners</span><b class="d">{new Set(winners.map((w) => w.name)).size.toLocaleString("en-GB")}</b></div>
      <div><span class="label-caps"><Icon name="clock" size={14} />Latest draw</span><b class="d">{winners[0] ? ago(winners[0].at) : "Soon"}</b></div>
    </div>
    <div class="row g8" style="margin-top:24px"><a class="chip on" href="/winners" aria-current="true">Draw Winners</a><a class="chip" href="/instant-winners">Instant Winners</a></div>
  </div></section>
  <section class="sec" style="padding-top:32px"><div class="wrap stack g16">
    {winners.length > 0 && <div class="row between"><span class="label-caps">Showing <b style="color:#EEF0FF">{winners.length}</b> of {winners.length}</span><span class="ep-badge ep-badge-c"><Icon name="check" size={12} />All draws verified</span></div>}
    {winners.length ? <div class="ep-results">{winners.map((w) => (
      <article class="ep-result">
        <span class="ep-result-av d">{w.name.slice(0, 1)}</span>
        <div class="ep-result-b">
          <div class="label-caps">Winner · {ukDate(w.at)}</div>
          <div class="d ep-result-n">{w.name}</div>
          <div class="ep-result-p">{w.prizeName}</div>
          <div class="hint" style="font-size:12px">{w.competitionTitle}{w.ticketNumber ? ` · winning ticket #${w.ticketNumber}` : ""}</div>
          {(w.videoUrl || w.verifyUrl) && <div class="row wrapx g8" style="margin-top:8px">{w.videoUrl && <a class="btn btn-c btn-sm" href={w.videoUrl} rel="noopener" target="_blank"><Icon name="play" size={16} /> Watch The Draw</a>}{w.verifyUrl && <a class="btn btn-o btn-sm" href={w.verifyUrl}>Verify</a>}</div>}
        </div>
        {w.verifyUrl ? <a class="ep-verified" href={w.verifyUrl}>Verified</a> : <span class="ep-verified">Verified</span>}
      </article>
    ))}</div> : <div class="card empty">Our first draw winners on the new site are coming soon.</div>}
    {upcoming.length > 0 && <div class="stack g8" style="margin-top:24px"><h2 class="h3">Next Up</h2><div class="card" style="overflow:hidden">{upcoming.map((d) => <a class="li" href={`/competitions/${d.slug}`}><img src={d.imageSmall} alt="" style="width:48px;height:48px;border-radius:12px;object-fit:cover" /><span style="flex:1;min-width:0"><span style="display:block">{d.title}</span><span class="hint">{d.drawAt ? ukDateTime(d.drawAt) : ""}</span></span><span class="tag tag-c">Upcoming</span></a>)}</div></div>}
    {oldWinners.length > 0 && <div class="stack g8"><h2 class="h3">From Our Previous Site</h2><div class="card" style="overflow:hidden">{oldWinners.map((w) => <a class="li" href={`/previous/${w.competitionSlug}`}><span class="av">{w.name.slice(0, 1)}</span><span style="flex:1;min-width:0"><span style="display:block"><b>{w.name}</b>{w.town ? ` from ${w.town}` : ""} won {w.prizeName}</span><span class="hint">{w.ticketNumber ? `Winning ticket #${w.ticketNumber}` : ""}{w.at ? `${w.ticketNumber ? " · " : ""}${ukDateTime(w.at)}` : ""}</span></span><span class="chev"><Icon name="chev" size={18} /></span></a>)}</div><a class="tap" style="padding-left:0" href="/previous">All previous competitions, winners and entry lists</a></div>}
    <div class="notice notice-c"><Icon name="info" size={18} /><span>Instant-win winners appear in the <a href="/instant-winners">live feed</a> as soon as they win.</span></div>
  </div></section>
  <section class="ep-next-cta"><div class="wrap">
    <h2 class="h2">Your Name Could Be Next</h2>
    <p class="p">Enter today's live prize competitions for your chance to win.</p>
    <a class="btn btn-y btn-lg" href="/competitions">View Live Competitions</a>
  </div></section>
</Layout>
